# PostgreSQL
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=openjob
PGHOST=localhost
PGPORT=5432

# Server
HOST=localhost
PORT=3000

# JWT
ACCESS_TOKEN_KEY=your-access-token-secret
REFRESH_TOKEN_KEY=your-refresh-token-secret

# Redis
REDIS_HOST=localhost

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Optional: full AMQP URL (takes precedence over RABBITMQ_*)
# AMQP_URL=amqp://guest:guest@localhost:5672

# Reserved for future email notifications
# MAIL_HOST=
# MAIL_PORT=
# MAIL_USER=
# MAIL_PASSWORD=
